# Ports (scripts/dev.sh). Change BACKEND_PORT when 8000 is already taken.
BACKEND_PORT=8000
FRONTEND_PORT=5173
DASHBOARD_PORT=8501
# Used by the Vite dev proxy (frontend/vite.config.ts) and the dashboard
BACKEND_URL=http://localhost:8000
# Path to a trained policy checkpoint (state_dict + metadata json side-car)
POLICY_CHECKPOINT=backend/models/policy.pt
# Force CPU even if CUDA is available (1 = force)
FORCE_CPU=0
# Streamlit -> where the 3D scene is served and where the API lives
SCENE_URL=http://localhost:5173/
API_URL=http://localhost:8000
